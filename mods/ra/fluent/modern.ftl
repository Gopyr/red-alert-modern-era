## Modern Units (Gopyr mod additions)
actor-mbt =
    .name = M1 Abrams MBT
    .generic-name = Tank
    .description =
    Modern main battle tank with upgraded armor and firepower.
      Strong vs Vehicles
      Weak vs Infantry and Aircraft

actor-ltnk =
    .name = M8 Light Tank
    .generic-name = Tank
    .description =
    Fast reconnaissance tank with light armor.
      Strong vs Light armor
      Weak vs Infantry, Tanks and Aircraft

actor-atnk =
    .name = Assault Tank
    .generic-name = Tank
    .description =
    Super-heavy breakthrough tank, slow but extremely tough.
      Strong vs Everything
      Weak vs Aircraft

actor-etnk =
    .name = EMP Support Tank
    .generic-name = Tank
    .description =
    Support tank equipped with EMP capability.
    Disables enemy vehicles on hit.
      Strong vs Vehicles
      Weak vs Infantry and Aircraft

actor-stnk2 =
    .name = Predator Stealth Tank
    .generic-name = Tank
    .description =
    Silent variant of the stealth tank. Cloaked anti-armor platform.
      Strong vs Vehicles and Aircraft
      Weak vs Infantry

actor-gdd =
    .name = Guided Missile Destroyer
    .description =
    Modernized destroyer with stronger anti-air and surface missiles.
